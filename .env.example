# Copy to .env.local. Everything is optional for local development.

# Hosted Postgres for the members database (Supabase/Neon, Singapore region).
# Unset = local PGlite database in .data/ with demo members.
DATABASE_URL=
# SEED_DEMO=0            # start the local database empty

# Protect /admin with one shared passcode until staff logins exist.
ADMIN_PASSCODE=

# Renewal reminder emails (Resend). Unset = reminders are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="Superfit <hello@example.com>"
# Vercel Cron sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=

# Shared secret Qashier sends in the x-superfit-secret header to /api/qashier/webhook.
QASHIER_WEBHOOK_SECRET=

# Adobe Fonts kit for Avenir Next LT Pro.
NEXT_PUBLIC_ADOBE_FONTS_KIT=
